# Copy this file to .env and fill in your values
# NEVER commit .env to git!

SECRET_KEY=change-me-to-a-long-random-string

# MySQL (used in docker-compose, don't change unless you edit docker-compose.yml)
DATABASE_URL=mysql+pymysql://wedding_user:wedding_pass@mysql:3306/wedding_db

# Green API (WhatsApp) — free at green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# Google AI (Gemini) — get from aistudio.google.com
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
